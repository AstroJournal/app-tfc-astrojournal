CREATE TABLE collectible (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    eventId INTEGER NOT NULL,   -- ← CAMBIO IMPORTANTE
    eventName TEXT NOT NULL DEFAULT '',
    observationDate TEXT NOT NULL,
    notes TEXT,
    observed INTEGER NOT NULL DEFAULT 0,
    agended INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM collectible;

selectById:
SELECT * FROM collectible WHERE id = ?;

selectByEventId:
SELECT * FROM collectible WHERE eventId = ?;

insertCollectible:
INSERT INTO collectible(eventId, eventName, observationDate, notes, observed, agended)
VALUES (?, ?, ?, ?, ?, ?);

updateObserved:
UPDATE collectible
SET observed = :observed
WHERE id = :id;

updateNotes:
UPDATE collectible
SET notes = :notes
WHERE id = :id;

updateNotesByEventId:
UPDATE collectible
SET notes = :notes
WHERE eventId = :eventId;

updateAgended:
UPDATE collectible
SET agended = :agended
WHERE id = :id;

deleteById:
DELETE FROM collectible WHERE id = ?;

deleteAll:
DELETE FROM collectible;
