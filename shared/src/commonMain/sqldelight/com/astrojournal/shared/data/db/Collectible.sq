CREATE TABLE Collectible (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    eventId INTEGER NOT NULL,
    observationDate TEXT NOT NULL,
    notes TEXT
);

selectAllCollectibles:
SELECT * FROM Collectible;

insertCollectible:
INSERT INTO Collectible(eventId, observationDate, notes)
VALUES (?, ?, ?);

deleteCollectible:
DELETE FROM Collectible WHERE id = ?;

deleteAllCollectibles:
DELETE FROM Collectible;
