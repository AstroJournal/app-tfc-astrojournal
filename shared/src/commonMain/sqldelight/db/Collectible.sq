CREATE TABLE collectible (
    id TEXT NOT NULL PRIMARY KEY,
    eventId TEXT NOT NULL,
    observationDate TEXT NOT NULL,
    notes TEXT
);

selectAll:
SELECT * FROM collectible;

selectById:
SELECT * FROM collectible WHERE id = ?;

insertCollectible:
INSERT INTO collectible(id, eventId, observationDate, notes)
VALUES (?, ?, ?, ?);

deleteById:
DELETE FROM collectible WHERE id = ?;

deleteAll:
DELETE FROM collectible;
